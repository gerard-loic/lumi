{

    "app" : {
       "name" : "Nom du service",
       "description" : "Description du service",
       "allowed_cors_ips" : ["*"],
       "allowed_cors_methods" : ["*"],
       "allowed_cors_headers" : ["*"],
       "url" : "https://service.fr",
       "ws_inactivity_timeout" : 300,
       "default_language" : "fr",
       "admin_users" : [
            {
                "username" : "",
                "password" : ""
            }
       ]
    },

    "authentication" : {
        "service" : "apiservice",
        "jwt_secret" : "",
        "jwt_algorithm": "HS256",
        "session_duration" : 3600
    },

    "services" : {
        "nexora" : {
            "handler" : "LumePackAPI",
            "url" : "http://api.exemple.local",
            "timeout" : 60
        },
        "bdd" : {
            "handler" : "PostgreSQL",
            "host" : "0.0.0.0",
            "port" : 5432,
            "database" : "dbname",
            "username" : "",
            "password" : ""
        },
        "external_mcp_example" : {
            "handler" : "MCPExternalService",
            "transport" : "http",
            "url" : "https://mcp.exemple.local/mcp",
            "headers" : { "Authorization" : "Bearer <token>" }
        }
    },

    "logger" : {
        "output" : {
            "enabled" : true
        },
        "file" : {
            "enabled" : true,
            "path": "logs"
        }
    },

    "profiles" : {
        "default" : {
            "llm" : {
                "system_prompt_file": "config/systemprompt.md",
                "connector": "LiteLLM",
                "memory_messages": 5,
                "empty_llm_response_max_retry": 2,
                "followup_questions": {
                    "enabled": true,
                    "count": 3
                },
                "filters": {
                    "CodeFilter": {}
                },
                "LiteLLM": {
                    "model": "openai/openai/gpt-oss-120b",
                    "embedding_model": "openai/Qwen/Qwen3-Embedding-0.6B",
                    "api_base": "https://provider.fr/v1",
                    "api_key": ""
                }
            },
            "languages" : [
                "fr",
                "en"
            ],
            "mcp" : {
                "max_tool_iterations": 10,
                "tools_enabled": [
                    "datetime.*",
                    "eligibility.*",
                    "geobase.*",
                    "orders.*",
                    "references.*",
                    "search_knowledge_base",
                    "generer_fichier_excel",
                    "generer_fichier_pdf",
                    "rechercher_sur_internet",
                    "lire_page_web",
                    "word.*",
                    "files.*"
                ]
            },
            "attachments" : {
                "enabled" : true,
                "max_file_size_mb" : 20,
                "file_context_top_k": 8,
                "max_files" : 5,
                "allowed_extensions" : [".pdf", ".docx", ".doc", ".pptx", ".ppt", ".xlsx", ".xls", ".md", ".html", ".htm", ".py", ".js", ".ts", ".txt", ".csv"]
            },
            "rag" : {
                "collection" : "demo"
            },
            "connectors" : {
                "webex" : {
                    "enabled": false,
                    "bot_token": "",
                    "webhook_secret": "",
                    "webex_api" : "https://webexapis.com/v1",
                    "api_key" : "",
                    "allow_group_messages": false
                }
            }
        }
    },

    "usage" : {
        "max_tokens_month" : -1,
        "max_requests_month" : -1,
        "max_requests_minute" : 5
    },

    "directories" : {
        "temp_dir" : "storage/temp",
        "local_storage_dir" : "storage/data",
        "languages_dir" : "static/languages",
        "rag_storage_dir" : "storage/rag",
        "custom_languages_dir" : "config/languages",
        "custom_services_dir" : "config/services",
        "custom_mcp_tools_dir" : "config/tools"
    },

    "word" : {
        "template" : "config/templates/gabarit-document.docx",
        "template_placeholder" : "{{content}}",
        "template_summary_placeholder" : "{{summary}}",
        "template_title_placeholder" : "{{title}}",
        "template_date_placeholder" : "{{date}}",
        "template_array_style" : "Tableau Gabarit",
        "page_break_before_heading1" : false,
        "heading_style_1" : "Heading 1",
        "heading_style_2" : "Heading 2",
        "heading_style_3" : "Heading 3"
    },

    "pdf" : {
        "template_color" : "1F4E79",
        "template_logo" : null,
        "template_footer_text" : null
    },

    "rag" : {
        "embedding_dim" : 1024,
        "top_k" : 5,
        "chunk_size" : 500,
        "chunk_overlap" : 50,
        "connector" : "PgVector",
        "pgvector" : {
            "table" : "rag_documents"
        }
    },

    "cron" : []
}